# Anthropic API key for the Claude Agent SDK — https://console.anthropic.com/settings/keys
# Not needed if you are already signed in with the Claude Code CLI on this machine.
ANTHROPIC_API_KEY=

# Optional: model for the lead auditor, detectors, and materiality gate.
# OPEN_LEASE_AUDIT_MODEL=claude-opus-5

# Optional: model for the per-lease abstractors. Defaults to inheriting the
# model above; set it to run the mechanical abstraction pass on a cheaper tier.
# OPEN_LEASE_AUDIT_ABSTRACTOR_MODEL=claude-sonnet-5

# Optional: hard spend ceiling for one audit run, in USD. Default 8.
# OPEN_LEASE_AUDIT_MAX_BUDGET_USD=8
